# ============================================
# CivicOps - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env files with real secrets

# ============================================
# DOCKER COMPOSE / DATABASE
# ============================================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=civicOps

# Database URL (used by Prisma)
DATABASE_URL=postgresql://postgres@localhost:5432/civicOps?schema=public

# ============================================
# APPLICATION
# ============================================

# Environment: development, production, test
NODE_ENV=development

# Backend API
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# Frontend
FRONTEND_PORT=3000

# Chatbot Service
CHATBOT_PORT=8001

# ============================================
# REDIS
# ============================================

REDIS_URL=redis://localhost:6379

# ============================================
# AUTHENTICATION (JWT)
# ============================================

# Generate secure secrets:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

JWT_SECRET=change-this-super-secret-jwt-key-in-production-min-32-chars
JWT_REFRESH_SECRET=change-this-super-secret-refresh-key-in-production-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ============================================
# CORS
# ============================================

CORS_ORIGIN=http://localhost:3000

# ============================================
# RATE LIMITING
# ============================================

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# FILE UPLOAD
# ============================================

MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# ============================================
# CLOUDFLARE R2 (Object Storage)
# ============================================

CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY=your-r2-access-key
CLOUDFLARE_R2_SECRET_KEY=your-r2-secret-key
CLOUDFLARE_R2_BUCKET=civicops-files
CLOUDFLARE_R2_PUBLIC_URL=https://your-cdn-url.r2.dev

# ============================================
# AWS (Optional - for deployment)
# ============================================

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# S3 (alternative to R2)
AWS_S3_BUCKET=civicops-files

# ============================================
# EMAIL (SMTP)
# ============================================

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@civicops.com

# ============================================
# WEBHOOKS
# ============================================

WEBHOOK_SECRET=your-webhook-signing-secret
WEBHOOK_TIMEOUT=30000
WEBHOOK_MAX_RETRIES=3

# ============================================
# AI / CHATBOT
# ============================================

AI_API_KEY=your-openai-api-key
AI_MODEL=gpt-4-turbo-preview
CHATBOT_SERVICE_URL=http://localhost:8001

# ============================================
# LOGGING
# ============================================

LOG_LEVEL=debug

# ============================================
# FRONTEND (Vite)
# ============================================

VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=http://localhost:8000
VITE_APP_NAME=CivicOps
