# CivicOps Worker Environment Variables

# Environment
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civicops?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@civicops.com

# Webhook
WEBHOOK_TIMEOUT=30000
WEBHOOK_MAX_RETRIES=3

# Logging
LOG_LEVEL=debug
