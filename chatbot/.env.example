# CivicOps Chatbot Service Environment Variables

# Server
HOST=0.0.0.0
PORT=8001
DEBUG=false

# Backend API (Node.js main backend)
BACKEND_API_URL=http://localhost:8000/api/v1

# AI Provider
AI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-4-turbo-preview

# Redis
REDIS_URL=redis://localhost:6379

# Database (optional - for chatbot conversation history)
DATABASE_URL=postgresql://postgres:password@localhost:5432/civicops

# JWT (must match backend)
JWT_SECRET=your_jwt_secret_here

# Logging
LOG_LEVEL=INFO
