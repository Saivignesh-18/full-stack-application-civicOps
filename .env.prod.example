# ============================================
# CivicOps - PRODUCTION env (copy to .env on the EC2 host)
# Used by compose.prod.yaml
# ============================================

# --- Database (Postgres runs in a container; pick a strong password) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=civicops

# --- JWT secrets (generate with: openssl rand -hex 48) ---
JWT_SECRET=CHANGE_ME_long_random_secret_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_another_long_random_secret
JWT_ACCESS_EXPIRES=60m
JWT_REFRESH_EXPIRES=30d

# --- Public URL of the app (the browser origin). ---
# Use your domain once DNS is set, e.g. https://civicops.example.com
# For an initial IP-only test: http://<EC2_PUBLIC_IP>
CORS_ORIGIN=http://<EC2_PUBLIC_IP>

# --- Rate limiting (keep enabled in production) ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
DISABLE_RATE_LIMIT=false

# --- Logging ---
LOG_LEVEL=info

# --- Groq AI chatbot ---
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
